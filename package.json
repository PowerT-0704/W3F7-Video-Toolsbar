{
  "name": "w3f7-video-toolsbar",
  "version": "0.1.0-preview.1",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "description": "W3F7のVideo_Toolsbar · Local video cover tools",
  "scripts": {
    "build:bat": "node scripts/build-bat.mjs",
